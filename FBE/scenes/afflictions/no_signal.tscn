[gd_scene load_steps=2 format=3]

[sub_resource type="Shader" id="Shader_no_signal"]
code = "shader_type canvas_item;

uniform float refresh_rate : hint_range(1.0, 60.0, 1.0) = 12.0;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void fragment() {
	float frame = floor(TIME * refresh_rate);
	// The overlay is exactly 300 by 422 in the card's native coordinate space. Using that space gives
	// one independently changing noise sample per card pixel instead of a repeated UV tile.
	vec2 pixel = floor(UV * vec2(300.0, 422.0));
	float row_shift = (hash12(vec2(floor(pixel.y / 3.0), frame * 7.0)) - 0.5) * 5.0;
	pixel.x += row_shift;

	float grain = hash12(pixel + vec2(frame * 41.0, frame * 17.0));
	float grain_b = hash12(pixel.yx * vec2(1.73, 0.61) + vec2(frame * 13.0, frame * 29.0));
	float row_noise = hash12(vec2(floor(pixel.y * 0.5), frame * 19.0));
	float scanline = 0.90 + 0.10 * sin(pixel.y * 2.2 + TIME * 18.0);
	float dropout = step(0.988, hash12(vec2(floor(pixel.y / 4.0), frame * 3.0)));

	vec3 static_color = vec3(grain);
	static_color.r = mix(static_color.r, grain_b, 0.16);
	static_color.b = mix(static_color.b, grain_b, 0.28);
	static_color = mix(static_color, vec3(row_noise), 0.20);
	static_color = mix(static_color, vec3(0.015, 0.035, 0.065), dropout);
	static_color *= scanline;

	COLOR = vec4(clamp(static_color, 0.0, 1.0), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_no_signal"]
